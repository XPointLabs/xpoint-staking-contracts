{
  "name": "xpoint-staking-contracts",
  "version": "1.0.0",
  "description": "Deep XPoint staking contracts preserving Session reward distribution semantics",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat deploy --network",
    "deploy-local": "hardhat run scripts/deploy-local-test.js --network localhost",
    "deploy-local-devnet": "hardhat run scripts/deploy-local-devnet.js --network localhost",
    "deploy-uat-arbitrum-sepolia": "hardhat run scripts/deploy-uat-arbitrum-sepolia.js --network arbitrumSepolia",
    "validate:reward-emission-uat": "hardhat run scripts/validate-reward-emission-upgrade.js --network arbitrumSepolia",
    "upgrade:reward-emission-uat": "hardhat run scripts/upgrade-reward-emission-uat.js --network arbitrumSepolia",
    "smoke:reward-emission-uat": "hardhat run scripts/smoke-reward-emission-uat.js --network arbitrumSepolia",
    "simulate:reward-emission-production": "hardhat run scripts/simulate-production-reward-emission-upgrade.js",
    "prepare:reward-emission-production": "node scripts/metamask-upgrade-reward-emission-mainnet.js",
    "prepare:start-production": "node scripts/metamask-start-service-node-rewards-mainnet.js",
    "simulate:start-production": "hardhat run scripts/simulate-production-start.js",
    "devnet-smoke": "hardhat run scripts/local-devnet-smoke.js --network localhost",
    "export-abis": "hardhat compile && node scripts/export-abis.js",
    "hardhat-node": "hardhat node",
    "coverage": "hardhat coverage",
    "lint": "pnpm lint:sol && pnpm lint:ts",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "lint:ts": "eslint --max-warnings 0 .",
    "fmt:sol": "prettier 'contracts/**/*.sol' -w",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
